<% layout('layouts/boilerplate') -%>

<section class="container">
  <h1 class="display-6">My Cart</h1>
  <div class="row">
    <div class="col-lg-8">
      <% for(let item of user.cart){ %>
        <div class="card mx-auto mb-3" style="max-width: 540px;">
          <div class="row g-0">
            <div class="col-4">
              <img src="<%=item.img%>" class="img-fluid rounded-start" alt="...">
            </div>
            <div class="col-8">
              <div class="card-body">
                <h5 class="card-title"><%=item.name%></h5>
                <p class="card-text"><%=item.desc%></p>
                <p class="card-text">Rs.<%=item.price%></p>
              </div>
            </div>
          </div>
        </div>
      <% } %> 
    </div>
    <div class="col-lg-4">
      <ul class="list-group">
        <% for(let item of user.cart) { %>
          <li class="list-group-item"><span class="fw-bold"><%=item.name%> - </span>Rs. <%=item.price%></li>
        <% } %> 
        <li class="list-group-item fw-bold">Total Amount: Rs. <%=totalAmount%></li>
      </ul>

      <form action="/create-checkout-session" method="post">
        <% for(let item of user.cart) { %>
          <input type="hidden" name="products[]" value='<%= JSON.stringify(item) %>'>
        <% } %>
        <button type="submit" class="btn btn-sm btn-success my-3">Checkout</button>
      </form>
      <form action="/user/cart/clear" method="POST">
        <button type="submit" class="btn btn-danger btn-sm my-2">Clear Cart</button>
      </form>
      

    </div>
  </div>
</section>